{
    "openapi": "3.1.0",
    "info": {
        "title": "Browser Renderer API",
        "description": "Cloudflare Worker for browser automation via Playwright. Provides navigate, screenshot, click, type, extract, scroll, and evaluate actions.",
        "version": "1.0.0"
    },
    "paths": {
        "/action": {
            "post": {
                "operationId": "browserAction",
                "summary": "Execute a browser action",
                "tags": ["Browser"],
                "parameters": [],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/BrowserActionRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Action result",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BrowserActionResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "operationId": "getHealth",
                "summary": "Health check",
                "tags": ["Health"],
                "responses": {
                    "200": {
                        "description": "Service health status",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HealthResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "BrowserActionRequest": {
                "type": "object",
                "required": ["action"],
                "properties": {
                    "action": {
                        "type": "string",
                        "enum": ["navigate", "screenshot", "click", "type", "extract", "scroll", "evaluate"],
                        "description": "The browser action to execute"
                    },
                    "url": {
                        "type": "string",
                        "description": "URL to navigate to (required for navigate action)"
                    },
                    "selector": {
                        "type": "string",
                        "description": "CSS selector for click, type, and extract actions"
                    },
                    "text": {
                        "type": "string",
                        "description": "Text to type (required for type action)"
                    },
                    "direction": {
                        "type": "string",
                        "enum": ["up", "down"],
                        "description": "Scroll direction"
                    },
                    "fullPage": {
                        "type": "boolean",
                        "description": "Whether to capture full page screenshot"
                    },
                    "script": {
                        "type": "string",
                        "description": "JavaScript to evaluate (max 5000 chars)"
                    },
                    "sessionId": {
                        "type": "string",
                        "description": "Reconnect to an existing browser session"
                    }
                }
            },
            "BrowserActionResponse": {
                "type": "object",
                "properties": {
                    "success": { "type": "boolean" },
                    "sessionId": { "type": "string" },
                    "url": { "type": "string" },
                    "title": { "type": "string" },
                    "screenshot": { "type": "string", "description": "Base64-encoded JPEG" },
                    "screenshotFormat": { "type": "string" },
                    "content": { "type": "string", "description": "Extracted text content" },
                    "truncated": { "type": "boolean" },
                    "clickedSelector": { "type": "string" },
                    "typedText": { "type": "string" },
                    "typedSelector": { "type": "string" },
                    "direction": { "type": "string" },
                    "scrollPosition": {
                        "type": "object",
                        "properties": {
                            "x": { "type": "number" },
                            "y": { "type": "number" },
                            "maxY": { "type": "number" }
                        }
                    },
                    "result": { "type": "string", "description": "JavaScript evaluation result" },
                    "error": { "type": "string" }
                }
            },
            "HealthResponse": {
                "type": "object",
                "properties": {
                    "status": { "type": "string" },
                    "service": { "type": "string" }
                }
            },
            "ErrorResponse": {
                "type": "object",
                "properties": {
                    "success": { "type": "boolean" },
                    "error": { "type": "string" }
                }
            }
        }
    }
}

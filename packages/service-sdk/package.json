{
    "name": "@neore/service-sdk",
    "version": "1.0.0",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./llm-gateway": {
            "types": "./dist/llm-gateway.d.ts",
            "default": "./dist/llm-gateway.js"
        },
        "./document-parser": {
            "types": "./dist/document-parser.d.ts",
            "default": "./dist/document-parser.js"
        },
        "./nsfw-checker": {
            "types": "./dist/nsfw-checker.d.ts",
            "default": "./dist/nsfw-checker.js"
        },
        "./browser-renderer": {
            "types": "./dist/browser-renderer.d.ts",
            "default": "./dist/browser-renderer.js"
        }
    },
    "files": [
        "./dist",
        "./src"
    ],
    "scripts": {
        "build": "packem build --development",
        "build:prod": "packem build --production",
        "clean": "rimraf node_modules dist .eslintcache",
        "generate": "tsx scripts/generate.ts",
        "generate:extract": "tsx scripts/extract-specs.ts",
        "lint:eslint": "eslint . --cache --cache-location .eslint.cache.json",
        "lint:eslint:fix": "eslint . --fix --cache --cache-location .eslint.cache.json",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore --ignore-path .prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore --ignore-path .prettierignore",
        "lint:types": "tsc --noEmit"
    },
    "dependencies": {},
    "devDependencies": {
        "@anolilab/eslint-config": "catalog:lint",
        "@anolilab/prettier-config": "catalog:lint",
        "@hey-api/openapi-ts": "0.99.0",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:bundler",
        "@visulima/packem-rollup": "catalog:bundler",
        "esbuild": "catalog:build",
        "eslint": "catalog:lint",
        "prettier": "catalog:lint",
        "rimraf": "catalog:node",
        "rollup": "catalog:bundler",
        "tsx": "catalog:iac",
        "typescript": "catalog:tsc"
    },
    "engines": {
        "node": ">=22.x"
    }
}

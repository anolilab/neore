{
    "extends": "../../tsconfig.base.json",
    "composite": true,
    "compilerOptions": {
        "composite": true,
        "moduleResolution": "bundler",
        "paths": {
            "@neore/ai": ["./src/index.ts"],
            "@neore/ai/*": ["./src/*"]
        }

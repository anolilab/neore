{
    "name": "@neore/ai",
    "version": "1.0.0",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./constants": {
            "types": "./dist/constants.d.ts",
            "default": "./dist/constants.js"
        },
        "./design": {
            "types": "./dist/design/index.d.ts",
            "default": "./dist/design/index.js"
        },
        "./gateway": {
            "types": "./dist/gateway.d.ts",
            "default": "./dist/gateway.js"
        },
        "./constants/cinema": {
            "types": "./dist/constants/cinema.d.ts",
            "default": "./dist/constants/cinema.js"
        },
        "./models": {
            "types": "./dist/models/index.d.ts",
            "default": "./dist/models/index.js"
        },
        "./providers": {
            "types": "./dist/providers/index.d.ts",
            "default": "./dist/providers/index.js"
        },
        "./tools": {
            "types": "./dist/tools/index.d.ts",
            "default": "./dist/tools/index.js"
        },
        "./prompts": {
            "types": "./dist/prompts/index.d.ts",
            "default": "./dist/prompts/index.js"
        },
        "./prompts/cinema": {
            "types": "./dist/prompts/cinema.d.ts",
            "default": "./dist/prompts/cinema.js"
        },
        "./prompts/optimizer": {
            "types": "./dist/prompts/optimizer/index.d.ts",
            "default": "./dist/prompts/optimizer/index.js"
        },
        "./types/cinema": {
            "types": "./dist/types/cinema.d.ts",
            "default": "./dist/types/cinema.js"
        },
        "./utils": {
            "types": "./dist/utils/index.d.ts",
            "default": "./dist/utils/index.js"
        }
    },
    "files": [
        "./dist",
        "./src"
    ],
    "scripts": {
        "build": "packem build --development",
        "build:prod": "packem build --production",
        "clean": "rimraf node_modules dist .eslintcache",
        "lint:eslint": "eslint . --cache --cache-location .eslint.cache.json",
        "lint:eslint:fix": "eslint . --fix --cache --cache-location .eslint.cache.json",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@ai-sdk/black-forest-labs": "catalog:ai",
        "@ai-sdk/fal": "catalog:ai",
        "@ai-sdk/fireworks": "catalog:ai",
        "@ai-sdk/google": "catalog:ai",
        "@ai-sdk/groq": "catalog:ai",
        "@ai-sdk/klingai": "catalog:ai",
        "@ai-sdk/luma": "catalog:ai",
        "@ai-sdk/openai": "catalog:ai",
        "@ai-sdk/provider": "catalog:ai",
        "@ai-sdk/react": "catalog:ai",
        "@ai-sdk/replicate": "catalog:ai",
        "@ai-sdk/ui-utils": "catalog:ai",
        "@ai-sdk/xai": "catalog:ai",
        "@openrouter/ai-sdk-provider": "catalog:ai",
        "@requesty/ai-sdk": "catalog:ai",
        "@visulima/iso-locale": "catalog:i18n",
        "ai": "catalog:ai",
        "ollama-ai-provider-v2": "catalog:ai"
    },
    "devDependencies": {
        "@anolilab/eslint-config": "catalog:lint",
        "@anolilab/prettier-config": "catalog:lint",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:bundler",
        "@visulima/packem-rollup": "catalog:bundler",
        "esbuild": "catalog:build",
        "eslint": "catalog:lint",
        "jiti": "catalog:cli",
        "prettier": "catalog:lint",
        "rimraf": "catalog:node",
        "rollup": "catalog:bundler",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": ">=22.x"
    }
}

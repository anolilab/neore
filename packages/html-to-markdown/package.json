{
    "name": "@neore/html-to-markdown",
    "version": "0.0.0",
    "private": true,
    "description": "HTML to Markdown converter, forked from turndown (MIT). See README.md.",
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc --noEmit",
        "lint:eslint": "eslint . --cache --cache-location .eslint.cache.json",
        "lint:eslint:fix": "eslint . --fix --cache --cache-location .eslint.cache.json",
        "lint:types": "tsc --noEmit",
        "lint:types:fast": "tsrs --noEmit",
        "test": "vitest run",
        "test:bench": "tsx bench/run.ts"
    },
    "dependencies": {
        "@mixmark-io/domino": "2.2.0"
    },
    "devDependencies": {
        "@anolilab/eslint-config": "catalog:lint",
        "@types/node": "catalog:types",
        "eslint": "catalog:lint",
        "tsx": "catalog:iac",
        "turndown": "7.2.5",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": ">=22.x"
    }
}

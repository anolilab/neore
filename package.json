{
    "name": "neore",
    "version": "0.0.0",
    "private": true,
    "license": "FSL-1.1-ALv2",
    "author": {
        "name": "Daniel Bannert",
        "url": "https://github.com/anolilab/neore"
    },
    "contributors": [
        {
            "name": "Daniel Bannert",
            "url": "https://github.com/anolilab/neore"
        }
    ],
    "type": "module",
    "workspaces": [
        "apps/*",
        "backend",
        "packages/*",
        "services/*",
        "tools/*"
    ],
    "scripts": {
        "audit": "vis audit --fail-on low",
        "build:affected:packages": "vis affected build --fail-fast",
        "build:affected:prod:packages": "vis affected build:prod --fail-fast",
        "build:chat": "vis run build --projects=@neore/web",
        "build:packages": "vis run build --query=\"tag=type:package\"",
        "build:packages:prod": "vis run build:prod --query=\"tag=type:package\"",
        "clean": "vis run clean && rimraf ./node_modules && pnpm run cleanup:empty-packages",
        "cleanup:empty-packages": "node scripts/cleanup-empty-packages.js",
        "codegen:backend": "vis run codegen --projects=@neore/backend",
        "deploy": "tsx alchemy.run.ts",
        "deploy:destroy": "DESTROY=true tsx alchemy.run.ts",
        "dev": "vis run dev --projects=@neore/web,@neore/backend,llm-gateway",
        "dev:app": "vis run dev --projects=@neore/web",
        "dev:backend": "vis run dev --projects=@neore/backend",
        "dev:browser-renderer": "vis run dev --projects=browser-renderer",
        "dev:chat": "vis run dev --projects=@neore/web,@neore/backend,llm-gateway",
        "dev:document-parser": "vis run dev --projects=document-parser",
        "dev:embeddings": "vis run dev --projects=embeddings",
        "dev:llm-gateway": "vis run dev --projects=llm-gateway",
        "dev:nsfw-checker": "vis run dev --projects=nsfw-checker",
        "dev:setup": "node scripts/dev-setup.js",
        "dev:stack": "vis run dev --projects=@neore/web,@neore/backend,llm-gateway,embeddings",
        "env:generate-encryption": "node scripts/generate-encryption-key.js",
        "env:generate-signing-secret": "node -e \"process.stdout.write(require('crypto').randomBytes(32).toString('hex') + '\\n')\"",
        "generate": "jiti plopfile.ts",
        "generate:labeler": "node scripts/generate-labeler-config.js",
        "graph": "vis graph",
        "lint": "pnpm run lint:prettier && pnpm run lint:eslint && pnpm run lint:dedupe",
        "lint:affected:attw": "vis affected lint:attw",
        "lint:affected:eslint": "vis affected lint:eslint",
        "lint:affected:package-json": "vis affected lint:package-json",
        "lint:affected:types": "vis affected lint:types",
        "lint:dedupe": "pnpm dedupe --check",
        "lint:eslint": "vis run lint:eslint",
        "lint:eslint:deploy": "eslint alchemy.run.ts scripts/worker-bundle.ts",
        "lint:eslint:fix": "vis run lint:eslint:fix",
        "lint:prettier": "pnpm run lint:prettier:root && vis run lint:prettier",
        "lint:prettier:fix": "pnpm run lint:prettier:root:fix && vis run lint:prettier:fix",
        "lint:prettier:root": "prettier --config=.prettierrc.cjs --check '*.{json,yml,yaml,js,mjs,cjs,ts}'",
        "lint:prettier:root:fix": "prettier --config=.prettierrc.cjs --write '*.{json,yml,yaml,js,mjs,cjs,ts}'",
        "lint:secrets": "vis secrets",
        "lint:staged": "vis staged --verbose --concurrent false --debug",
        "lint:types": "vis run lint:types && pnpm run lint:types:deploy",
        "lint:types:deploy": "tsc -p tsconfig.deploy.json",
        "native:build": "pnpm --filter @neore/native run tauri:build",
        "native:dev": "pnpm --filter @neore/native run tauri:dev",
        "postinstall": "vis hook install --force && node scripts/generate-labeler-config.js",
        "preinstall": "node -e \"if(process.env.CI == 'true') {console.info('Skipping preinstall...')} else {process.exit(1)}\" || (node verify-node-version.js && npm -y exec only-allow pnpm)",
        "sort-package-json": "sort-package-json packages/**/package.json apps/*/package.json backend/package.json services/*/package.json tools/*/package.json ./package.json",
        "test:e2e": "pnpm --filter=app test:e2e"
    },
    "packageManager": "pnpm@12.8.1",
    "devDependencies": {
        "@anolilab/commitlint-config": "catalog:lint",
        "@anolilab/multi-semantic-release": "catalog:release",
        "@anolilab/prettier-config": "catalog:lint",
        "@commitlint/cli": "catalog:lint",
        "@commitlint/config-conventional": "catalog:lint",
        "@eslint/js": "catalog:lint",
        "@swc-node/register": "catalog:bundler",
        "@swc/cli": "catalog:bundler",
        "@swc/core": "catalog:bundler",
        "@swc/helpers": "catalog:bundler",
        "@types/node": "catalog:types",
        "@visulima/vis": "4.1.12",
        "@visulima/yaml": "catalog:",
        "@vitest/coverage-v8": "catalog:test",
        "@vitest/ui": "catalog:test",
        "alchemy": "catalog:iac",
        "commitizen": "catalog:cli",
        "dotenv": "catalog:node",
        "esbuild": "catalog:build",
        "eslint": "catalog:lint",
        "eslint-config-prettier": "catalog:lint",
        "jiti": "catalog:cli",
        "jsdom": "catalog:test",
        "jsonc-eslint-parser": "catalog:lint",
        "jspdf": "catalog:utils",
        "plop": "catalog:cli",
        "prettier": "catalog:lint",
        "prettier-plugin-tailwindcss": "catalog:lint",
        "react-dropzone": "catalog:forms",
        "semantic-release": "catalog:release",
        "shiki": "catalog:syntax",
        "sort-package-json": "catalog:utils",
        "tslib": "catalog:bundler",
        "tsx": "catalog:iac",
        "typescript": "catalog:tsc",
        "typescript-eslint": "catalog:lint",
        "vite": "catalog:build",
        "vitest": "catalog:test"
    }
}

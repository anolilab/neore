{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2024",
        "jsx": "react-jsx",
        "lib": ["ES2024"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["@cloudflare/workers-types", "node"],
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*", "lunora/**/*"],
    "exclude": ["node_modules", "dist"]
}

#!/usr/bin/env sh

# Fast checks only: the CI failures that cost the most review rounds.
# Type check and lint are heavier; run them before opening a pull request and
# before each push that changes behaviour (docs/agents/review-checklist.md).
pnpm exec sort-package-json --check packages/*/package.json apps/*/package.json backend/package.json services/*/package.json package.json || exit 1

# Prettier on every file changed since the merge base with main, root files
# included; Markdown is skipped, as in CI.
base=$(git merge-base HEAD origin/main 2>/dev/null) || exit 0
git diff --name-only --diff-filter=ACMR -z "$base" HEAD -- . ':!*.md' ':!*.mdx' \
    | xargs -0 -r pnpm exec prettier --config=.prettierrc.cjs --ignore-unknown --check || exit 1

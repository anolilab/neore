#!/usr/bin/env sh

# Fast checks only: the CI failures that cost the most review rounds.
# Type check and lint are heavier; run them before opening a pull request and
# before each push that changes behaviour (docs/agents/review-checklist.md).
pnpm exec sort-package-json --check packages/*/package.json apps/*/package.json backend/package.json services/*/package.json package.json || exit 1

# Prettier on every file changed since the merge base with main, root files
# included; Markdown is skipped, as in CI. Portable: no GNU-only xargs flags.
base=$(git merge-base HEAD origin/main 2>/dev/null) || {
    git fetch --quiet origin main && base=$(git merge-base HEAD origin/main)
} || {
    echo "pre-push: cannot find the merge base with origin/main; fetch it, then push again." >&2
    exit 1
}
files=$(git diff --name-only --diff-filter=ACMR "$base" HEAD -- . ':!*.md' ':!*.mdx')
[ -z "$files" ] && exit 0
# shellcheck disable=SC2086 # one path per line, no spaces in tracked paths
printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 pnpm exec prettier --config=.prettierrc.cjs --ignore-unknown --check || exit 1

# The one ignore file for formatting. oxfmt and Prettier both read it (with .gitignore,
# nested ones included) from the repository root: `pnpm lint:oxfmt`, the commit hook and
# the push hook all run there, so a project-level ignore file would never be read.
**/dist/
**/coverage/
/.vis/cache

# Build and tool artifacts, anywhere in the tree. Gitignored, but listed so a run on a
# path given by name skips them too.
# backend/.lunora/build/bundle-meta.json is 3.6 MB and blows the output buffer.
**/.lunora/
# Emitted by `lunora build --emit-bindings`; the generator rewrites it unformatted.
backend/lunora-bindings.json
# Codegen output. Anything written there is discarded by the next `pnpm codegen`, and
# `lunora dev` regenerates on any source change, so a reformat is both pointless and a
# source of phantom diffs.
**/_generated/
**/routeTree.gen.ts
**/.lunora-schema.json
**/lunora.advisor.map.json
**/.wrangler/
# Playwright run artifacts. Already in .gitignore, but prettier and eslint read
# the working tree, so a local `pnpm test:e2e` would otherwise fail the lint.
**/e2e/.results/
**/.alchemy/
**/.source/
**/.eslint.cache.json

# Lingui-compiled message catalogues. Minified single-line output carrying an
# `/*eslint-disable*/` banner — `lingui compile` rewrites them, so formatting
# is churn. The .po sources next to them are the editable artefact.
**/src/locales/*/messages.js

# Tool-owned serialisations, rewritten by their generator on every run, so
# formatting them only starts a fight prettier cannot win. pnpm's YAML writer
# owns the two pnpm files; the skills sync writes skills-lock.json at indent=2.
#
# pnpm-workspace.yaml is here despite being hand-edited: an install that CHANGES
# the dependency set reflows the whole file to 2-space and hoists auditConfig to
# the top. An install that changes nothing leaves it alone, which is what made it
# look safe.
/pnpm-lock.yaml
/pnpm-workspace.yaml
/skills-lock.json

# `wrangler types` rewrites this with tabs on every postinstall, so prettier
# reformatting it to 4-space guarantees a dirty tree after any install. It is
# also machine-specific: wrangler reads apps/web/.env, so whatever a developer
# has locally lands in a TRACKED file (a stale VITE_LUNORA_SITE_URL is how this
# was found).
apps/web/worker-configuration.d.ts

# `email-render.test.ts` asserts `expect(html).toBe(expected)` against these
# fixtures — byte-identical, not parsed. Prettier reformatting them breaks all
# seven cases, and `lint:oxfmt:fix` would do it silently. They are generated
# by `render()`, so their formatting is react-email's to choose, not ours.
backend/lunora/email/templates/__fixtures__/
# MSW's service worker, copied in by `msw init`: a vendored script, so it is not reformatted.
**/.storybook/public/mockServiceWorker.js
# Written by `pnpm generate` in the SDK (scripts/generate.ts -> orval), which does not
# format its output: the next generate overwrites a reformat.
packages/service-sdk/src/generated/
# Recorded share pages: their inline scripts are captured bytes, not source to reformat.
backend/lunora/chat-import/lib/fixtures/
# Build output the browser extension writes next to `dist/`.
apps/browser-extension/dist-firefox/
apps/browser-extension/release/
# cargo and worker-build output of the Rust Worker (generated, minified JS and wasm).
services/document-parser/build/
services/document-parser/target/
# Static assets and build output of the web app and the UI package, served as they are.
apps/web/**/public/
apps/web/**/build/
packages/ui/**/public/
packages/ui/**/build/

# Not formatted. These projects have no format check, and the mobile ESLint style rules
# reject some formatter output. Remove a line when its project gains one.
apps/desktop/
apps/mobile/
packages/client-runtime/
packages/device-core/
packages/device-core-node/
# Installed agent skills and local agent settings: third-party text, synced from upstream.
/.agents/
/.claude/
# Handlebars templates of the service generator: not valid code until rendered.
**/*.hbs
# Documentation Markdown that has never had a format check: the docs tree, root
# Markdown and the GitHub community files. Each project's own Markdown is checked.
docs/**/*.md
docs/**/*.mdx
/*.md
/.github/*.md

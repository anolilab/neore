{
    "expo": {
        "name": "Neore",
        "slug": "neore",
        "version": "0.0.0",
        "scheme": "neore-mobile",
        "orientation": "portrait",
        "userInterfaceStyle": "automatic",
        "ios": {
            "bundleIdentifier": "ai.neore.mobile",
            "supportsTablet": false
        },
        "android": {
            "package": "ai.neore.mobile"
        },
        "plugins": [
            "expo-router",
            "expo-secure-store",
            "expo-web-browser",
            [
                "expo-audio",
                {
                    "enableBackgroundPlayback": false,
                    "microphonePermission": "Neore records your voice while you hold the microphone button. The recording is sent to Neore and a speech-to-text provider to turn it into text for your message, and is not stored."
                }
            ]
        ],
        "experiments": {
            "typedRoutes": false
        },
        "runtimeVersion": {
            "policy": "fingerprint"
        },
        "updates": {
            "enabled": true,
            "checkAutomatically": "ON_LOAD",
            "fallbackToCacheTimeout": 0
        }
    }
}

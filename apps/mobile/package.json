        "@neore/chat-ui": "workspace:*",
        "@neore/client-runtime": "workspace:*",
        "expo": "58.0.26",
        "expo-audio": "~58.0.12",
        "expo-auth-session": "~58.0.19",
        "expo-constants": "~58.0.16",
        "expo-crypto": "~58.0.8",
        "expo-file-system": "~58.0.14",
        "expo-font": "~58.0.12",
        "expo-linking": "~58.0.17",
        "expo-network": "~58.0.5",
        "expo-notifications": "~58.1.9",
        "expo-router": "~58.0.32",
        "expo-secure-store": "~58.0.3",
        "expo-speech-recognition": "58.0.1",
        "expo-splash-screen": "~58.0.14",

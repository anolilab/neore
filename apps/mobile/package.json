{
    "name": "@neore/mobile",
    "version": "0.0.0",
    "private": true,
    "main": "expo-router/entry",
    "scripts": {
        "android": "expo run:android",
        "build": "expo export --platform ios --platform android --output-dir dist",
        "ios": "expo run:ios",
        "lint:eslint": "eslint . --cache --cache-location .eslint.cache.json",
        "lint:types": "tsc --noEmit",
        "start": "expo start",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text-summary"
    },
    "dependencies": {
        "@expo/metro-runtime": "~58.0.14",
        "@legendapp/list": "^3.6.0",
        "@lunora/client": "catalog:lunora",
        "@neore/backend": "workspace:*",
        "@neore/chat-ui": "workspace:*",
        "@neore/client-runtime": "workspace:*",
        "expo": "58.0.14",
        "expo-auth-session": "~58.0.13",
        "expo-constants": "~58.0.12",
        "expo-crypto": "~58.0.7",
        "expo-font": "~58.0.8",
        "expo-linking": "~58.0.13",
        "expo-network": "~58.0.4",
        "expo-router": "~58.0.23",
        "expo-secure-store": "~58.0.2",
        "expo-splash-screen": "~58.0.10",
        "expo-sqlite": "~58.0.14",
        "expo-status-bar": "~58.0.3",
        "expo-system-ui": "~58.0.6",
        "expo-web-browser": "~58.0.6",
        "react": "catalog:react",
        "react-dom": "catalog:react",
        "react-native": "0.88.0",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "~5.10.1",
        "react-native-screens": "~4.30.0",
        "react-native-worklets": "0.13.0"
    },
    "devDependencies": {
        "@anolilab/eslint-config": "catalog:lint",
        "@react-native/metro-config": "0.88.0",
        "@types/node": "catalog:types",
        "@types/react": "catalog:types",
        "babel-preset-expo": "~58.0.17",
        "eslint": "catalog:lint",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": ">=22.x"
    }
}

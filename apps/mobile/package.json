{
    "name": "@neore/mobile",
    "version": "0.0.0",
    "private": true,
    "main": "index.ts",
    "scripts": {
        "android": "expo run:android",
        "build": "expo export --platform ios --platform android --output-dir dist",
        "ios": "expo run:ios",
        "lint:eslint": "eslint . --cache --cache-location .eslint.cache.json",
        "lint:types": "tsc --noEmit",
        "lint:types:fast": "tsrs --noEmit",

VITE_DEBUG=false

# This is needed for the Lunora client connection
LUNORA_DEPLOYMENT=anonymous:anonymous-neore-chat

# URLs
# Lunora worker origin: one worker serves both /_lunora/rpc and /api/auth/*.
# Must equal the backend PUBLIC_ORIGIN (backend/wrangler.jsonc), or every
# bearer token verifies as anonymous and the app looks signed-out.
VITE_LUNORA_URL="http://localhost:8788"

# LLM Gateway (required — all chat requests route through the gateway)
VITE_LLM_GATEWAY_URL=http://localhost:5173/llm-gateway
# Choose between http://127.0.0.1:5173 or http://localhost:5173 on the local env
VITE_SITE_URL="http://127.0.0.1:5173"

# GDPR Configuration
VITE_DPO_EMAIL=
VITE_DPO_NAME=
VITE_PRIVACY_POLICY_URL=

# c15t Consent Management
# Options: "offline" (local storage) or "c15t" (online backend)
VITE_C15T_MODE=offline
VITE_C15T_BACKEND_URL=

# Cloudflare Turnstile CAPTCHA (optional, enables bot protection on auth forms)
# Get keys from https://dash.cloudflare.com/ → Turnstile
VITE_TURNSTILE_SITE_KEY=

# Required
VITE_POSTHOG_API_KEY=phc_your_api_key
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Optional (for local feature flag evaluation)
POSTHOG_PERSONAL_API_KEY=phx_your_personal_api_key

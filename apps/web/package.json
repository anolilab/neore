    "type": "module",
    "scripts": {
        "build": "node scripts/generate-og.mjs && vite build && node scripts/generate-sw.mjs && tsc --noEmit",
        "generate:pwa-assets": "pwa-assets-generator",
        "clean": "rimraf node_modules dist .eslintcache .tanstack",
        "dev": "vite dev --port 5173",
        "email:dev": "email dev --dir src/components/emails --port 5555",
        "lint:eslint": "eslint . --cache --cache-location .eslint.cache.json",
        "lint:eslint:fix": "eslint . --fix --cache --cache-location .eslint.cache.json",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore --ignore-path .prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore --ignore-path .prettierignore",
        "lint:types": "tsc --noEmit",
        "preview": "npm run build && vite preview",
        "cf:typegen": "wrangler types",
        "postinstall": "pnpm run cf:typegen",
        "start": "node dist/server/index.mjs",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "translate:auto": "node scripts/translate-catalogs.mjs",
        "translate:clean": "lingui extract --clean",
        "translate:compile": "lingui compile",
        "translate:extract": "lingui extract"
    },

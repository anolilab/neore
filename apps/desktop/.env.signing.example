# Code signing for `pnpm --filter @neore/desktop run dist`. For a local signed build,
# copy this file to `.env` (git-ignored) and fill in what you have. In CI, put the
# same names in the environment as secrets; never commit real values. Empty values
# mean an unsigned build, which is what runs today.
#
# electron-builder reads these names itself; no code here uses them.

# --- macOS: Developer ID signing (electron-builder) ---
# Path to, or base64 of, the Developer ID Application .p12 certificate.
CSC_LINK=
CSC_KEY_PASSWORD=
# Optional: the identity name when the keychain holds more than one.
CSC_NAME=

# --- macOS: notarization ---
APPLE_ID=
# An app-specific password for APPLE_ID, not the account password.
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# --- Windows: Authenticode (NSIS installer) ---
# Path to, or base64 of, the code-signing .p12 or .pfx certificate.
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=

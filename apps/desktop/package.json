{
    "name": "@neore/desktop",
    "version": "0.0.0",
    "private": true,
    "description": "Electron desktop shell around the deployed Neore web app",
    "type": "module",
    "main": "dist/main.cjs",
    "scripts": {
        "build": "node scripts/build.mjs",
        "dist": "NEORE_RELEASE=1 node scripts/build.mjs && electron-builder --config electron-builder.yml --publish never",
        "lint:eslint": "eslint . --cache --cache-location .eslint.cache.json",
        "pack": "NEORE_RELEASE=1 node scripts/build.mjs && electron-builder --dir --config electron-builder.yml",
        "smoke": "node scripts/smoke.mjs",
        "smoke:artifacts": "node scripts/smoke-artifacts.mjs",
        "start": "pnpm run build && electron .",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@neore/device-core-node": "workspace:*",
        "electron-updater": "6.8.9"
    },
    "devDependencies": {
        "@anolilab/eslint-config": "catalog:lint",
        "@electron/fuses": "2.1.3",
        "@playwright/test": "catalog:test",
        "electron": "44.4.5",
        "electron-builder": "26.15.3",
        "esbuild": "catalog:build",
        "eslint": "catalog:lint",
        "eslint-import-resolver-typescript": "4.4.5",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    }
}

# URL of the Anole Chat web app (used for auth requests).
# The backend must list this extension in TRUSTED_EXTENSION_ORIGINS=chrome-extension://<id>,
# or sign-in is rejected as cross-origin.
VITE_APP_URL=https://neore.ai

# Lunora backend Worker — serves /_lunora/rpc, /api/auth/* and the HTTP routes.
# One origin, not two: the old VITE_CONVEX_URL / VITE_CONVEX_SITE_URL pair existed
# only because Convex split RPC (.convex.cloud) from HTTP (.convex.site).
# Must equal the backend's PUBLIC_ORIGIN, or every bearer token verifies as anonymous.
VITE_LUNORA_URL=http://localhost:8788

# LLM Gateway (required — all chat requests route through the gateway)
VITE_LLM_GATEWAY_URL=http://localhost:8787

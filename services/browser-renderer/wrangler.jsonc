{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "browser-renderer",
    "main": "src/index.ts",
    // Private: no workers.dev URL and no route. The backend reaches this Worker
    // only through its service binding (`backend/lunora.config.ts`).
    "workers_dev": false,
    "compatibility_date": "2025-09-15",
    "compatibility_flags": ["nodejs_compat"],
    // As in alchemy.run.ts: a function handed to `page.evaluate` runs in the page, where `__name(…)` does not exist.
    "keep_names": false,
    "placement": {
        "mode": "smart"
    },
    "observability": {
        "enabled": true
    },
    "browser": {
        "binding": "BROWSER"
    },
    // The hold on each browser session every isolate sees (src/session-lock.ts). Not inherited by an `env`: each repeats it.
    "durable_objects": {
        "bindings": [{ "name": "SESSION_LOCK", "class_name": "SessionLock" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionLock"] }],
    "vars": {
        "NODE_ENV": "development"
    },
    "env": {
        "production": {
            "name": "browser-renderer",
            "durable_objects": {
                "bindings": [{ "name": "SESSION_LOCK", "class_name": "SessionLock" }]
            },
            "vars": {
                "NODE_ENV": "production"
            }
        },
        "preview": {
            "name": "browser-renderer-preview",
            "durable_objects": {
                "bindings": [{ "name": "SESSION_LOCK", "class_name": "SessionLock" }]
            },
            "vars": {
                "NODE_ENV": "development"
            }
        }
    }
}

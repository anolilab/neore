# HMAC shared secret for Backend <-> Gateway authentication
SIGNING_SECRET=your-signing-secret-here

# Lunora backend origin — chunk polling, API-key validation, usage reporting.
# Must equal the backend's own PUBLIC_ORIGIN and the app's VITE_LUNORA_URL;
# `scripts/dev-setup.js` writes the local value.
LUNORA_URL=http://localhost:8788

# Comma-separated allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3005,http://localhost:5173,http://localhost:4173

# Workers AI (the default text and embedding models). Deployed, the gateway uses
# its `AI` binding and needs neither. Locally there is no binding, so the
# REST API needs an account id and an API token with Workers AI read access.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=

# Provider API keys (optional: for models outside Workers AI)
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
REQUESTY_API_KEY=
FAL_API_KEY=
